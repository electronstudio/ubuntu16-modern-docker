FROM --platform=linux/386 i386/ubuntu:16.04

# Update package lists and install basic dependencies
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    git \
    build-essential \
    ca-certificates \
    unzip \
    pkg-config \
    libasound2-dev \
    mesa-common-dev \
    libx11-dev \
    libxrandr-dev \
    libxi-dev \
    xorg-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libwayland-dev \
    libxkbcommon-dev \
    openjdk-8-jdk \
    software-properties-common \
    apt-transport-https \
    gnupg \
    lsb-release \
    libgles2-mesa-dev \
    libc6-dev g++-multilib \
    zlib1g-dev libncurses-dev libgdbm-dev libnss3-dev libreadline6-dev libffi-dev libsqlite3-dev libbz2-dev libgbm-dev \
    liblzma-dev libmpdec-dev uuid-dev tk-dev \
    && rm -rf /var/lib/apt/lists/*

# Install newer Git (via PPA)
RUN add-apt-repository ppa:git-core/ppa \
    && apt-get update \
    && apt-get install -y git \
    && rm -rf /var/lib/apt/lists/*


# Install Node.js 20 (32-bit unofficial build)
RUN curl -fsSL https://unofficial-builds.nodejs.org/download/release/v20.18.1/node-v20.18.1-linux-x86.tar.gz | tar -xz -C /usr/local --strip-components=1


# Install modern CMake
RUN wget https://github.com/Kitware/CMake/releases/download/v3.31.12/cmake-3.31.12-linux-x86_64.tar.gz \
    && tar xvfz cmake-3.31.12-linux-x86_64.tar.gz \
    && cp -r cmake-3.31.12-linux-x86_64/* /usr/

# Compile and install OpenSSL 1.1.1 from source (kzalewski fork: 1.1.1zh with backported security fixes)
RUN wget https://github.com/kzalewski/openssl-1.1.1/archive/refs/tags/1.1.1zh.tar.gz -O openssl-1.1.1zh.tar.gz \
    && tar -xzf openssl-1.1.1zh.tar.gz \
    && cd openssl-1.1.1-1.1.1zh \
    && setarch i386 ./config \
    && make -j$(nproc) \
    && make install_sw install_ssldirs \
    && ldconfig \
    && cd .. && rm -rf openssl-1.1.1*

# Point OpenSSL's compiled-in CA paths at the system CA bundle.
# OpenSSL installs to /usr/local/ssl, so its default cafile/capath
# (/usr/local/ssl/cert.pem, /usr/local/ssl/certs) are empty and every Python
# built against it fails HTTPS certificate verification. The distro bundle
# lives at /etc/ssl/certs/ca-certificates.crt - link it into place.
RUN ln -sf /etc/ssl/certs/ca-certificates.crt /usr/local/ssl/cert.pem \
    && ln -sf /etc/ssl/certs/ca-certificates.crt /usr/local/ssl/certs/ca-certificates.crt \
    && echo "Checking CA bundle is usable by OpenSSL:" \
    && openssl verify /etc/ssl/certs/ca-certificates.crt >/dev/null \
    && echo "CA bundle OK"


# Install multiple Python versions with SSL support
#
# Extra configure flags needed on xenial (both are version-gated so they are
# ignored on the older Pythons that do not understand them):
#  * --without-system-libmpdec: CPython 3.13+ auto-detects the system libmpdec
#    and requires >= 2.5.0, but xenial ships 2.4.2. Without this flag `_decimal`
#    is silently dropped and `decimal` falls back to the (10-100x slower)
#    pure-Python implementation. The bundled libmpdec in the CPython tarball
#    is used instead.
#  * TCLTK_CFLAGS/TCLTK_LIBS: xenial's tcl8.6-dev/tk8.6-dev ship no .pc files,
#    so CPython's pkg-config probe fails and `_tkinter` is skipped.
#
# KNOWN LIMITATION: `_sqlite3` is missing from 3.13+ because xenial's SQLite
# (3.11.0) is older than the 3.15.2 that CPython 3.13+ requires. `import
# sqlite3` therefore raises ModuleNotFoundError on 3.13/3.14/3.15. Python
# 3.12 and earlier are unaffected.
ARG PYTHON_VERSIONS="3.15.0 3.14.9 3.13.17 3.12.15 3.11.17 3.10.22 3.9.25 3.8.20 3.7.17"
RUN for version in $PYTHON_VERSIONS; do \
        wget https://www.python.org/ftp/python/$version/Python-$version.tgz && \
        tar -xf Python-$version.tgz && \
        cd Python-$version && \
        extra_flags=""; \
        if ./configure --help | grep -q -- '--without-system-libmpdec'; then \
            extra_flags="--without-system-libmpdec"; \
        fi; \
        setarch i386 ./configure --enable-optimizations $extra_flags \
            TCLTK_CFLAGS="-I/usr/include/tcl8.6" TCLTK_LIBS="-ltk8.6 -ltcl8.6" && \
        make -j$(nproc) && \
        make altinstall && \
        cd .. && \
        rm -rf Python-$version*; \
    done

# Fail the build if a module we expect to be present is missing, so silent
# regressions surface at build time instead of at import time in user code.
RUN for version in $PYTHON_VERSIONS; do \
        short=${version%.*}; \
        echo "Verifying optional modules for Python $short..."; \
        python$short -c "import _lzma, _uuid, _decimal, _tkinter" || exit 1; \
    done

# Install SDL
ARG SDL_VERSION="2.32.10"
RUN wget https://github.com/libsdl-org/SDL/archive/refs/tags/release-$SDL_VERSION.tar.gz \
    && tar xvfz release-$SDL_VERSION.tar.gz \
    && mkdir build \
    && cd build \
    && setarch i386 cmake ../SDL-release-$SDL_VERSION -DSDL_SHARED=OFF -DSDL_STATIC=ON -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DCMAKE_BUILD_TYPE=Release \
    && setarch i386 cmake --build . --config Release \
    && cmake --install . \
    && cd .. && rm -rf build SDL-release-$SDL_VERSION release-$SDL_VERSION.tar.gz

# Install PyPy 3.10 and 3.11
RUN wget https://downloads.python.org/pypy/pypy3.10-v7.3.19-linux32.tar.bz2 \
    && wget https://downloads.python.org/pypy/pypy3.11-v7.3.20-linux32.tar.bz2 \
    && tar -xjf pypy3.10-v7.3.19-linux32.tar.bz2 -C /opt \
    && tar -xjf pypy3.11-v7.3.20-linux32.tar.bz2 -C /opt \
    && ln -s /opt/pypy3.10-v7.3.19-linux32/bin/pypy3.10 /usr/local/bin/pypy3.10 \
    && ln -s /opt/pypy3.11-v7.3.20-linux32/bin/pypy3.11 /usr/local/bin/pypy3.11 \
    && /usr/local/bin/pypy3.10 -m ensurepip \
    && /usr/local/bin/pypy3.11 -m ensurepip \
    && ln -s /opt/pypy3.10-v7.3.19-linux32/bin/pip3 /usr/local/bin/pip-pypy3.10 \
    && ln -s /opt/pypy3.11-v7.3.20-linux32/bin/pip3 /usr/local/bin/pip-pypy3.11 \
    && rm pypy3.10-v7.3.19-linux32.tar.bz2 pypy3.11-v7.3.20-linux32.tar.bz2

# Install Go
ARG GO_VERSION="1.26.10"
RUN wget https://go.dev/dl/go${GO_VERSION}.linux-386.tar.gz \
    && tar -C /usr/local -xzf go${GO_VERSION}.linux-386.tar.gz \
    && rm go${GO_VERSION}.linux-386.tar.gz
ENV PATH=$PATH:/usr/local/go/bin


# Set working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]
