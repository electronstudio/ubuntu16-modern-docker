FROM --platform=linux/386 ubuntu:16.04


# Update package lists and install basic dependencies
RUN dpkg --add-architecture i386 \
    && apt-get update && apt-get install -y \
    wget:i386 \
    curl:i386 \
    build-essential \
    software-properties-common \
    ca-certificates:i386 \
    unzip:i386 \
    pkg-config:i386 \
    libasound2-dev:i386 \
    mesa-common-dev:i386 \
    libx11-dev:i386 \
    libxrandr-dev:i386 \
    libxi-dev:i386 \
    libgl1-mesa-dev:i386 \
    libglu1-mesa-dev:i386 \
    libwayland-dev:i386 \
    libxkbcommon-dev:i386 \
    apt-transport-https \
    gnupg:i386 \
    lsb-release:i386 \
    libgles2-mesa-dev:i386 \
    zlib1g-dev:i386 \
    libncurses-dev:i386 \
    libgdbm-dev:i386 \
    libnss3-dev:i386 \
    libreadline6-dev:i386 \
    libffi-dev:i386 \
    libsqlite3-dev:i386 \
    libbz2-dev:i386 \
    libgbm-dev:i386 \
    libc6:i386 \
    zlib1g:i386 \
    libc6-dev-i386 \
    ca-certificates-java:i386 \
    java-common:i386 \
    libcups2:i386 \
    liblcms2-2:i386 \
    libjpeg8:i386 \
    libfontconfig1:i386 \
    libfreetype6:i386 \
    libpcsclite1:i386 \
    libxtst6:i386 \
    libxinerama1:i386 \
    libgtk2.0-0:i386 \
    libgif7:i386  \
    libpulse0:i386 \
    libffi-dev zlib1g-dev

# Install modern CMake and Git
RUN wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc | apt-key add - \
    && echo 'deb https://apt.kitware.com/ubuntu/ xenial main' | tee /etc/apt/sources.list.d/kitware.list \
    && add-apt-repository ppa:git-core/ppa && apt-get update \
    && apt-get install -y cmake git \
    && rm -rf /var/lib/apt/lists/*

# Compile and install OpenSSL 1.1.1 from source 32 bit
RUN wget https://github.com/openssl/openssl/releases/download/OpenSSL_1_1_1w/openssl-1.1.1w.tar.gz \
    && tar -xzf openssl-1.1.1w.tar.gz \
    && cd openssl-1.1.1w \
    && setarch i386 ./config \
    && make -j$(nproc) \
    && make install_sw install_ssldirs \
    && ldconfig \
    && cd .. && rm -rf openssl-1.1.1*



# Install Java
RUN wget https://launchpad.net/~openjdk-security/+archive/ubuntu/ppa/+build/21437476/+files/openjdk-8-jre-headless_8u292-b10-0ubuntu1~16.04.1_i386.deb \
    && wget https://launchpad.net/~openjdk-security/+archive/ubuntu/ppa/+build/21437476/+files/openjdk-8-jre_8u292-b10-0ubuntu1~16.04.1_i386.deb \
    && dpkg -i *.deb \
    && rm -rf *.deb \
    && wget https://launchpad.net/~openjdk-security/+archive/ubuntu/ppa/+build/21437476/+files/openjdk-8-jdk-headless_8u292-b10-0ubuntu1~16.04.1_i386.deb \
    && wget https://launchpad.net/~openjdk-security/+archive/ubuntu/ppa/+build/21437476/+files/openjdk-8-jdk_8u292-b10-0ubuntu1~16.04.1_i386.deb \
    && dpkg -i *.deb \
    && rm -rf *.deb \
    && update-alternatives --set java /usr/lib/jvm/java-8-openjdk-i386/jre/bin/java

# Compile and install OpenSSL 1.1.1 from source 64bit
RUN wget https://github.com/openssl/openssl/releases/download/OpenSSL_1_1_1w/openssl-1.1.1w.tar.gz \
    && tar -xzf openssl-1.1.1w.tar.gz \
    && cd openssl-1.1.1w \
    && ./config \
    && make -j$(nproc) \
    && make install_sw install_ssldirs \
    && ldconfig \
    && cd .. && rm -rf openssl-1.1.1*

# Install multiple Python versions with SSL support
ARG PYTHON_VERSIONS="3.14.0"
RUN for version in $PYTHON_VERSIONS; do \
        wget https://www.python.org/ftp/python/$version/Python-$version.tgz && \
        tar -xf Python-$version.tgz && \
        cd Python-$version && \
        ./configure && \
        make -j$(nproc) && \
        make altinstall && \
        cd .. && \
        rm -rf Python-$version*; \
    done

# Compile and install OpenSSL 1.1.1 from source 32 bit
RUN wget https://github.com/openssl/openssl/releases/download/OpenSSL_1_1_1w/openssl-1.1.1w.tar.gz \
    && tar -xzf openssl-1.1.1w.tar.gz \
    && cd openssl-1.1.1w \
    && setarch i386 ./config \
    && make -j$(nproc) \
    && make install_sw install_ssldirs \
    && ldconfig \
    && cd .. && rm -rf openssl-1.1.1*

# echo ac_cv_file__dev_ptmx=no >CONFIG_SITE
# echo ac_cv_file__dev_ptc=no >>CONFIG_SITE
# CONFIG_SITE=CONFIG_SITE ./configure --build=x86_64-linux-gnu --host=i686-pc-linux-gnu --with-build-python=python3.14 --disable-ipv6 --with-config-site=./CONFIG_SITE

# Set working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]