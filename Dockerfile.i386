FROM --platform=linux/386 i386/ubuntu:16.04

# Update package lists and install basic dependencies
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    git \
    build-essential \
    ca-certificates \
    unzip \
    pkg-config \
    libasound2-dev \
    mesa-common-dev \
    libx11-dev \
    libxrandr-dev \
    libxi-dev \
    xorg-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libwayland-dev \
    libxkbcommon-dev \
    openjdk-8-jdk \
    software-properties-common \
    apt-transport-https \
    gnupg \
    lsb-release \
    libgles2-mesa-dev \
    libc6-dev g++-multilib \
    zlib1g-dev libncurses-dev libgdbm-dev libnss3-dev libreadline6-dev libffi-dev libsqlite3-dev libbz2-dev liblzma-dev libgbm-dev \
    && rm -rf /var/lib/apt/lists/*

# Install newer Git (via PPA)
RUN add-apt-repository ppa:git-core/ppa \
    && apt-get update \
    && apt-get install -y git \
    && rm -rf /var/lib/apt/lists/*


# Install Node.js 20 (32-bit unofficial build)
RUN curl -fsSL https://unofficial-builds.nodejs.org/download/release/v20.18.1/node-v20.18.1-linux-x86.tar.gz | tar -xz -C /usr/local --strip-components=1


# Install modern CMake
RUN wget https://github.com/Kitware/CMake/releases/download/v3.31.12/cmake-3.31.12-linux-x86_64.tar.gz \
    && tar xvfz cmake-3.31.12-linux-x86_64.tar.gz \
    && cp -r cmake-3.31.12-linux-x86_64/* /usr/

# Compile and install OpenSSL 1.1.1 from source (kzalewski fork: 1.1.1zh with backported security fixes)
# --openssldir=/etc/ssl so that clients built against it (Python) find the distro CA
# bundle: the OpenSSL default is /usr/local/ssl, whose certs/ dir is empty.
RUN wget https://github.com/kzalewski/openssl-1.1.1/archive/refs/tags/1.1.1zh.tar.gz -O openssl-1.1.1zh.tar.gz \
    && tar -xzf openssl-1.1.1zh.tar.gz \
    && cd openssl-1.1.1-1.1.1zh \
    && setarch i386 ./config --openssldir=/etc/ssl \
    && make -j$(nproc) \
    && make install_sw install_ssldirs \
    && ldconfig \
    && cd .. && rm -rf openssl-1.1.1*


# Install multiple Python versions with SSL support.
#
# Each version is built in its own layer: bumping one version only rebuilds that
# version instead of all of them.
#
# PGO (--enable-optimizations) is OFF by default to keep image builds fast;
# CI enables it with --build-arg PYTHON_ENABLE_PGO=1. It costs ~2x compile time
# per version and buys ~10-20% interpreter speed. It stays skipped on 3.7 even
# when enabled: 3.7's PGO training workload is the *full* test suite (the cheap
# --pgo subset only exists on 3.8+), making it by far the slowest version.
#
# /usr/local/lib/build-cpython always configures with:
#   --disable-test-modules      don't build nor install the test modules.
#   --without-static-libpython  skip libpython.a (only needed to embed).
# Neither option exists before 3.10; older configure scripts emit
# "WARNING: unrecognized options" and ignore them (still exit 0, verified
# against the 3.7.17 and 3.9.25 tarballs).
ARG PYTHON_SETARCH="setarch i386"
ARG PYTHON_ENABLE_PGO="0"
RUN printf '%s\n' \
        '#!/bin/sh' \
        'set -eu' \
        'set -x' \
        '' \
        'version="$1"' \
        'major="${version%%.*}"' \
        'minor="${version#*.}"' \
        'minor="${minor%%.*}"' \
        '' \
        'flags="--disable-test-modules --without-static-libpython"' \
        'if [ "${PYTHON_ENABLE_PGO:-0}" = "1" ]; then' \
        '    if [ "$major" -eq 3 ] && [ "$minor" -le 7 ]; then' \
        '        echo "Python 3.7: skipping --enable-optimizations (slow full-suite PGO)"' \
        '    else' \
        '        flags="$flags --enable-optimizations"' \
        '    fi' \
        'fi' \
        '' \
        'cd /tmp' \
        'rm -rf "Python-$version" "Python-$version.tgz"' \
        'wget -q "https://www.python.org/ftp/python/$version/Python-$version.tgz"' \
        'tar -xf "Python-$version.tgz"' \
        'cd "Python-$version"' \
        '${PYTHON_SETARCH:-} ./configure $flags' \
        'make -j"$(nproc)"' \
        '${PYTHON_SETARCH:-} make altinstall' \
        'cd /tmp' \
        'rm -rf "Python-$version" "Python-$version.tgz"' \
        > /usr/local/lib/build-cpython \
    && chmod +x /usr/local/lib/build-cpython

ARG PYTHON_VERSION_3_15="3.15.0"
RUN /usr/local/lib/build-cpython "$PYTHON_VERSION_3_15"

ARG PYTHON_VERSION_3_14="3.14.9"
RUN /usr/local/lib/build-cpython "$PYTHON_VERSION_3_14"

ARG PYTHON_VERSION_3_13="3.13.17"
RUN /usr/local/lib/build-cpython "$PYTHON_VERSION_3_13"

ARG PYTHON_VERSION_3_12="3.12.15"
RUN /usr/local/lib/build-cpython "$PYTHON_VERSION_3_12"

ARG PYTHON_VERSION_3_11="3.11.17"
RUN /usr/local/lib/build-cpython "$PYTHON_VERSION_3_11"

ARG PYTHON_VERSION_3_10="3.10.22"
RUN /usr/local/lib/build-cpython "$PYTHON_VERSION_3_10"

ARG PYTHON_VERSION_3_9="3.9.25"
RUN /usr/local/lib/build-cpython "$PYTHON_VERSION_3_9"

ARG PYTHON_VERSION_3_8="3.8.20"
RUN /usr/local/lib/build-cpython "$PYTHON_VERSION_3_8"

ARG PYTHON_VERSION_3_7="3.7.17"
RUN /usr/local/lib/build-cpython "$PYTHON_VERSION_3_7"

# Install SDL
ARG SDL_VERSION="2.32.10"
RUN wget https://github.com/libsdl-org/SDL/archive/refs/tags/release-$SDL_VERSION.tar.gz \
    && tar xvfz release-$SDL_VERSION.tar.gz \
    && mkdir build \
    && cd build \
    && setarch i386 cmake ../SDL-release-$SDL_VERSION -DSDL_SHARED=OFF -DSDL_STATIC=ON -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DCMAKE_BUILD_TYPE=Release \
    && setarch i386 cmake --build . --config Release --parallel "$(nproc)" \
    && cmake --install . \
    && cd .. && rm -rf build SDL-release-$SDL_VERSION release-$SDL_VERSION.tar.gz

# Install PyPy 3.10 and 3.11
RUN wget https://downloads.python.org/pypy/pypy3.10-v7.3.19-linux32.tar.bz2 \
    && wget https://downloads.python.org/pypy/pypy3.11-v7.3.20-linux32.tar.bz2 \
    && tar -xjf pypy3.10-v7.3.19-linux32.tar.bz2 -C /opt \
    && tar -xjf pypy3.11-v7.3.20-linux32.tar.bz2 -C /opt \
    && ln -s /opt/pypy3.10-v7.3.19-linux32/bin/pypy3.10 /usr/local/bin/pypy3.10 \
    && ln -s /opt/pypy3.11-v7.3.20-linux32/bin/pypy3.11 /usr/local/bin/pypy3.11 \
    && /usr/local/bin/pypy3.10 -m ensurepip \
    && /usr/local/bin/pypy3.11 -m ensurepip \
    && ln -s /opt/pypy3.10-v7.3.19-linux32/bin/pip3 /usr/local/bin/pip-pypy3.10 \
    && ln -s /opt/pypy3.11-v7.3.20-linux32/bin/pip3 /usr/local/bin/pip-pypy3.11 \
    && rm pypy3.10-v7.3.19-linux32.tar.bz2 pypy3.11-v7.3.20-linux32.tar.bz2

# Install Go
ARG GO_VERSION="1.26.10"
RUN wget https://go.dev/dl/go${GO_VERSION}.linux-386.tar.gz \
    && tar -C /usr/local -xzf go${GO_VERSION}.linux-386.tar.gz \
    && rm go${GO_VERSION}.linux-386.tar.gz
ENV PATH=$PATH:/usr/local/go/bin


# Install PyPy 3.12 by translating it from source.
# No official PyPy 3.12 build runs here: PyPy >= 8.0 (the first 3.12 series) is
# built in manylinux_2_28 and needs glibc >= 2.27, while xenial has 2.23.
# RPython is Python 2 code, so the PyPy 2.7 binary is used as host interpreter
# (much faster than CPython2.7). Costs ~25 min and ~4.5 GB RAM.
# cffi modules that cannot be built on xenial are skipped, not fatal:
#   sqlite3 (xenial SQLite 3.11 < PyPy's requirement), curses (no
#   libncursesw symlink), tkinter (no tk-dev).
ARG PYPY3_12_VERSION="8.0.1"
ARG PYPY2_7_VERSION="7.3.19"
RUN cd /tmp \
    && wget -q https://downloads.python.org/pypy/pypy2.7-v${PYPY2_7_VERSION}-linux32.tar.bz2 \
    && wget -q https://downloads.python.org/pypy/pypy3.12-v${PYPY3_12_VERSION}-src.tar.gz \
    && tar -xjf pypy2.7-v${PYPY2_7_VERSION}-linux32.tar.bz2 -C /opt \
    && tar -xzf pypy3.12-v${PYPY3_12_VERSION}-src.tar.gz \
    && cd pypy3.12-v${PYPY3_12_VERSION}-src/pypy/goal \
    && /opt/pypy2.7-v${PYPY2_7_VERSION}-linux32/bin/pypy ../../rpython/bin/rpython --make-jobs "$(nproc)" -Ojit targetpypystandalone.py \
    && mkdir -p /opt/pypy3.12-v${PYPY3_12_VERSION}-linux32/bin \
    && cp pypy3.12-c /opt/pypy3.12-v${PYPY3_12_VERSION}-linux32/bin/pypy3 \
    && cp libpypy3.12-c.so /opt/pypy3.12-v${PYPY3_12_VERSION}-linux32/bin/ \
    && cd ../.. \
    && cp -r lib-python lib_pypy include /opt/pypy3.12-v${PYPY3_12_VERSION}-linux32/ \
    && ln -s /opt/pypy3.12-v${PYPY3_12_VERSION}-linux32/bin/pypy3 /usr/local/bin/pypy3.12 \
    && pypy3.12 -m ensurepip \
    && ln -s /opt/pypy3.12-v${PYPY3_12_VERSION}-linux32/bin/pip3 /usr/local/bin/pip-pypy3.12 \
    && rm -rf /opt/pypy2.7-v${PYPY2_7_VERSION}-linux32 /tmp/pypy3.12-v${PYPY3_12_VERSION}-src* \
        /tmp/pypy2.7-v${PYPY2_7_VERSION}-linux32.tar.bz2 /tmp/usession-release-pypy3.12-*

# Set working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]
