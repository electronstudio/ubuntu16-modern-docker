FROM --platform=linux/386 ubuntu:16.04


# Update package lists and install basic dependencies
RUN dpkg --add-architecture i386 \
    && apt-get update && apt-get install -y \
    wget:i386 \
    curl:i386 \
    build-essential \
    software-properties-common \
    ca-certificates:i386 \
    unzip:i386 \
    pkg-config:i386 \
    libasound2-dev:i386 \
    mesa-common-dev:i386 \
    libx11-dev:i386 \
    libxrandr-dev:i386 \
    libxi-dev:i386 \
    libgl1-mesa-dev:i386 \
    libglu1-mesa-dev:i386 \
    libwayland-dev:i386 \
    libxkbcommon-dev:i386 \
    apt-transport-https \
    gnupg:i386 \
    lsb-release:i386 \
    libgles2-mesa-dev:i386 \
    zlib1g-dev:i386 \
    libncurses-dev:i386 \
    libgdbm-dev:i386 \
    libnss3-dev:i386 \
    libreadline6-dev:i386 \
    libffi-dev:i386 \
    libsqlite3-dev:i386 \
    libbz2-dev:i386 \
    libgbm-dev:i386 \
    libc6:i386 \
    zlib1g:i386 \
    libc6-dev-i386 \
    ca-certificates-java:i386 \
    java-common:i386 \
    libcups2:i386 \
    liblcms2-2:i386 \
    libjpeg8:i386 \
    libfontconfig1:i386 \
    libfreetype6:i386 \
    libpcsclite1:i386 \
    libxtst6:i386 \
    libxinerama1:i386 \
    libgtk2.0-0:i386 \
    libgif7:i386  \
    libpulse0:i386 \
    libffi-dev zlib1g-dev

# Install modern CMake and Git
RUN wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc | apt-key add - \
    && echo 'deb https://apt.kitware.com/ubuntu/ xenial main' | tee /etc/apt/sources.list.d/kitware.list \
    && add-apt-repository ppa:git-core/ppa && apt-get update \
    && apt-get install -y cmake git \
    && rm -rf /var/lib/apt/lists/*




# Compile and install OpenSSL 1.1.1 from source 64bit
RUN wget https://github.com/openssl/openssl/releases/download/OpenSSL_1_1_1w/openssl-1.1.1w.tar.gz \
    && tar -xzf openssl-1.1.1w.tar.gz \
    && cd openssl-1.1.1w \
    && ./config \
    && make -j$(nproc) \
    && make install_sw install_ssldirs \
    && ldconfig \
    && cd .. && rm -rf openssl-1.1.1* \
    && rm /usr/include/ncurses.h

# Install multiple Python versions with SSL support
ARG PYTHON_VERSIONS="3.14.0 3.13.6 3.12.9"
RUN for version in $PYTHON_VERSIONS; do \
        wget https://www.python.org/ftp/python/$version/Python-$version.tgz && \
        tar -xf Python-$version.tgz && \
        cd Python-$version && \
        ./configure && \
        make -j$(nproc) && \
        make altinstall && \
        cd .. && \
        rm -rf Python-$version*; \
    done

# Compile and install OpenSSL 1.1.1 from source 32 bit
RUN wget https://github.com/openssl/openssl/releases/download/OpenSSL_1_1_1w/openssl-1.1.1w.tar.gz \
    && tar -xzf openssl-1.1.1w.tar.gz \
    && cd openssl-1.1.1w \
    && setarch i386 ./config \
    && make -j$(nproc) \
    && make install_sw install_ssldirs \
    && ldconfig \
    && cd .. && rm -rf openssl-1.1.1*

# Install multiple Python versions with SSL support 32bit
ARG PYTHON_VERSIONS="3.14.0 3.13.6 3.12.9"
RUN for version in $PYTHON_VERSIONS; do \
        wget https://www.python.org/ftp/python/$version/Python-$version.tgz && \
        tar -xf Python-$version.tgz && \
        cd Python-$version && \
        echo ac_cv_file__dev_ptmx=no >CONFIG_SITE && \
        echo ac_cv_file__dev_ptc=no >>CONFIG_SITE && \
        CC="gcc -m32" CXX="g++ -m32" CONFIG_SITE=CONFIG_SITE ./configure --build=x86_64-linux-gnu --host=i686-pc-linux-gnu --with-build-python=python3.14 --disable-ipv6 --with-openssl=/usr/local/ssl --with-openssl-rpath=auto && \
        make -j$(nproc) && \
        make altinstall && \
        cd .. && \
        rm -rf Python-$version*; \
    done


# Install Java
RUN wget https://launchpad.net/~openjdk-security/+archive/ubuntu/ppa/+build/21437476/+files/openjdk-8-jre-headless_8u292-b10-0ubuntu1~16.04.1_i386.deb \
    && wget https://launchpad.net/~openjdk-security/+archive/ubuntu/ppa/+build/21437476/+files/openjdk-8-jre_8u292-b10-0ubuntu1~16.04.1_i386.deb \
    && dpkg -i *.deb \
    && rm -rf *.deb \
    && wget https://launchpad.net/~openjdk-security/+archive/ubuntu/ppa/+build/21437476/+files/openjdk-8-jdk-headless_8u292-b10-0ubuntu1~16.04.1_i386.deb \
    && wget https://launchpad.net/~openjdk-security/+archive/ubuntu/ppa/+build/21437476/+files/openjdk-8-jdk_8u292-b10-0ubuntu1~16.04.1_i386.deb \
    && dpkg -i *.deb \
    && rm -rf *.deb \
    && update-alternatives --set java /usr/lib/jvm/java-8-openjdk-i386/jre/bin/java

# Install Node.js 20 (32-bit unofficial build)
RUN curl -fsSL https://unofficial-builds.nodejs.org/download/release/v20.18.1/node-v20.18.1-linux-x86.tar.gz | tar -xz -C /usr/local --strip-components=1

# Install SDL
RUN wget https://github.com/libsdl-org/SDL/archive/refs/tags/release-2.32.8.tar.gz \
    && tar xvfz release-2.32.8.tar.gz \
    && mkdir build \
    && cd build \
    && cmake ../SDL-release-2.32.8 -DSDL_SHARED=OFF -DSDL_STATIC=ON -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DCMAKE_BUILD_TYPE=Release \
    && cmake --build . --config Release \
    && cmake --install . \
    && cd .. && rm -rf build SDL-release-2.32.8 release-2.32.8.tar.gz


# Install PyPy 3.10 and 3.11
RUN wget https://downloads.python.org/pypy/pypy3.10-v7.3.19-linux32.tar.bz2 \
    && wget https://downloads.python.org/pypy/pypy3.11-v7.3.20-linux32.tar.bz2 \
    && tar -xjf pypy3.10-v7.3.19-linux32.tar.bz2 -C /opt \
    && tar -xjf pypy3.11-v7.3.20-linux32.tar.bz2 -C /opt \
    && ln -s /opt/pypy3.10-v7.3.19-linux32/bin/pypy3.10 /usr/local/bin/pypy3.10 \
    && ln -s /opt/pypy3.11-v7.3.20-linux32/bin/pypy3.11 /usr/local/bin/pypy3.11 \
    && /usr/local/bin/pypy3.10 -m ensurepip \
    && /usr/local/bin/pypy3.11 -m ensurepip \
    && ln -s /opt/pypy3.10-v7.3.19-linux32/bin/pip3 /usr/local/bin/pip-pypy3.10 \
    && ln -s /opt/pypy3.11-v7.3.20-linux32/bin/pip3 /usr/local/bin/pip-pypy3.11 \
    && rm pypy3.10-v7.3.19-linux32.tar.bz2 pypy3.11-v7.3.20-linux32.tar.bz2

WORKDIR /workspace

# Default command
CMD ["/bin/bash"]